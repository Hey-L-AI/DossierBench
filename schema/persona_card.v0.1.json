{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Hey-L-AI/DossierBench/main/schema/persona_card.v0.1.json",
  "title": "Persona Card v0.1",
  "description": "A persona card for DossierBench (v0 card schema). The scorer dispatches on schema_version. contexts.default nesting is mandatory even though v0 populates only one context: v1 adds sibling blocks without a schema break. Do not flatten.",
  "type": "object",
  "required": [
    "schema_version",
    "subject_id",
    "hard_constraints",
    "contexts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "subject_id": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "description": "Timestamp. Unused in v0 scoring; present as the v2 drift hook, where ground truth becomes a time-indexed sequence of cards."
    },
    "hard_constraints": {
      "type": "object",
      "description": "Top-level, context-independent, scored separately as a gating track (spec \u00a78.2). Never averaged into fidelity.",
      "required": [
        "dietary",
        "allergies",
        "accessibility_needs",
        "alcohol_free_required"
      ],
      "additionalProperties": false,
      "properties": {
        "dietary": {
          "description": "Dietary rules the person will not break. Gating.",
          "x-metric": "jaccard",
          "x-provenance": "synthesized",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "vegetarian",
                  "vegan",
                  "pescatarian",
                  "halal",
                  "kosher",
                  "gluten_free",
                  "dairy_free",
                  "low_sodium",
                  "keto"
                ]
              },
              "uniqueItems": true
            },
            {
              "const": "unknown"
            }
          ]
        },
        "allergies": {
          "description": "Allergens that must be avoided. Gating; safety-critical.",
          "x-metric": "jaccard",
          "x-provenance": "synthesized",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "peanuts",
                  "tree_nuts",
                  "shellfish",
                  "fish",
                  "eggs",
                  "milk",
                  "soy",
                  "wheat",
                  "sesame"
                ]
              },
              "uniqueItems": true
            },
            {
              "const": "unknown"
            }
          ]
        },
        "accessibility_needs": {
          "description": "Access requirements a venue must meet. Gating.",
          "x-metric": "jaccard",
          "x-provenance": "synthesized",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "step_free_access",
                  "accessible_restroom",
                  "wide_aisles",
                  "low_lighting_ok",
