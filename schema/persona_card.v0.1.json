              },
              "uniqueItems": true
            },
            {
              "const": "unknown"
            }
          ]
        },
        "alcohol_free_required": {
          "description": "True when the person requires an alcohol-free setting. Gating, exact match.",
          "x-metric": "exact",
          "x-provenance": "synthesized",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown"
            }
          ]
        }
      }
